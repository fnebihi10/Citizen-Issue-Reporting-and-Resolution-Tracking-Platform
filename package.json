{
  "name": "citizen-issue-reporting",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:a11y": "playwright test --grep @a11y",
    "test:performance": "playwright test --grep @performance",
    "generate:dataset": "node generate_dataset.js",
    "check:dataset": "node generate_dataset.js --check",
    "verify:remote": "node scripts/verify-remote.mjs",
    "verify:sprint6": "node scripts/verify-sprint6-remote.mjs",
    "verify:local-auth": "node scripts/verify-local-auth.mjs",
    "generate:types": "supabase gen types typescript --linked --schema public > types/supabase.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@supabase/ssr": "0.10.0",
    "@supabase/supabase-js": "2.109.0",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.452.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "5.0.0",
    "tailwind-merge": "^2.5.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.16.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.26",
    "supabase": "^2.113.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10",
    "ws": "^8.21.3"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
